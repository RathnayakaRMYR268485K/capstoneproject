digraph G {
  rankdir=LR; fontname="Helvetica"; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef3fb", color="#4a6fa5"];
  edge [color="#555555"];
  subgraph cluster_src { label="Data sources"; style=dashed; color="#999999";
    wer [label="Epidemiology Unit (MoH)\nWeekly Epidemiological Reports\n(district-level dengue cases)"];
    pop [label="Dept. of Census & Statistics\n(population / age groups)"];
    geo [label="Boundary files\n(district / electoral GIS)"];
    env [label="Rainfall / temperature\n(optional predictors)", fillcolor="#f5f5f5"]; }
  subgraph cluster_etl { label="ETL & storage"; style=dashed; color="#999999";
    ex [label="Collection\n(R denguedatahub export /\nWER PDF parsing)"];
    pre [label="Preprocessing\nname standardisation, de-dup,\ngrid completion, weekly→monthly,\nimputation flags"];
    db [label="Relational + spatial store\n(CSV now → PostgreSQL/PostGIS)", shape=cylinder, fillcolor="#fff4d6", color="#b8860b"]; }
  subgraph cluster_an { label="Analytics"; style=dashed; color="#999999";
    eda [label="EDA &\nindicators"];
    km [label="K-means clustering\n(elbow + silhouette)"];
    base [label="Baseline:\nSeasonal naive"];
    imp [label="Improved:\nRandom Forest (direct 1/3/6/12-mo)\n+ SARIMA (national)"];
    bt [label="Rolling-origin back-test\nMAE / RMSE / MAPE\n+ 80% intervals"]; }
  subgraph cluster_app { label="Delivery"; style=dashed; color="#999999";
    api [label="REST API\n(planned: FastAPI)", fillcolor="#f5f5f5"];
    dash [label="Streamlit dashboard\nrisk map · trends · clusters · forecasts", fillcolor="#e3f4e1", color="#3b8a3b"]; }
  wer -> ex; pop -> pre; geo -> db; env -> pre [style=dashed]; ex -> pre -> db;
  db -> eda; db -> km; db -> base; db -> imp; base -> bt; imp -> bt;
  eda -> dash; km -> dash; bt -> dash; db -> api -> dash;
}
